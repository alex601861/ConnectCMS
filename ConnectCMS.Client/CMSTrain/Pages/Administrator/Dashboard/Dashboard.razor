@page "/home/admin-dashboard"
@attribute [Authorize]

<PageTitle>@Layout.PageTitle</PageTitle>

<div class="dashboard admin-dashboard">
    <div class="dashboard-header d-flex align-items-center justify-content-between flex-wrap mb-6">
        <div class="dashboard-header-text col-10">
            <MudText Typo="Typo.h6" Class="fw-bold text-dark">
                Namaste @UserDetail.Name 🙏 -
                <MudText Typo="Typo.subtitle2" HtmlTag="span" Class="text-normal">here’s what’s happening with your dashboard</MudText>
            </MudText>
        </div>
        <div class="col-2">
            <TimePeriodFilter Value="TimePeriod" ValueChanged="OnStatusFilter" />
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-center">
        <MudGrid Class="mb-6" Spacing="6">
            <MudItem xs="12" lg="12" xl="12">
                <div class="data-card-wrapper mb-6">
                    <div class="grid row gap-y-4">
                        <div class="item col-xxl-3 col-lg-3 col-md-6 col-12">
                            <div class="card">
                                <MudText Typo="Typo.subtitle1" Class="mb-4 card-title text-normal">
                                    Total Trainings
                                </MudText>
                                <div class="d-flex align-items-center justify-content-between">
                                    <MudText Typo="Typo.h2" Class="card-data">
                                        @(AdminDashboardCount.TotalTrainings)
                                    </MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Success" Class="rate d-flex align-items-center gap-3">
                                        <MudImage Src="images/icons/graph-up.svg" Height="24" Width="24" Alt="Graph Arrow Up" />
                                        @(AdminDashboardCount.TrainingGrowthPercent) %
                                    </MudText>
                                </div>
                            </div>
                        </div>
                        <div class="item col-xxl-3 col-lg-3 col-md-6 col-12">
                            <div class="card">
                                <MudText Typo="Typo.subtitle1" Class="mb-4 card-title text-normal">
                                    Total Registered Candidates
                                </MudText>
                                <div class="d-flex align-items-center justify-content-between">
                                    <MudText Typo="Typo.h2" Class="card-data">
                                        @(AdminDashboardCount.TotalRegisteredCandidates)
                                    </MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Error" Class="rate d-flex align-items-center gap-3">
                                        <MudImage Src="images/icons/graph-down.svg" Height="24" Width="24" Alt="Graph Arrow Down" />
                                        @(AdminDashboardCount.TotalRegisteredCandidatesGrowth) %
                                    </MudText>
                                </div>
                            </div>
                        </div>
                        <div class="item col-xxl-3 col-lg-3 col-md-6 col-12">
                            <div class="card">
                                <MudText Typo="Typo.subtitle1" Class="mb-4 card-title text-normal">
                                    Total Registered Trainers
                                </MudText>
                                <div class="d-flex align-items-center justify-content-between">
                                    <MudText Typo="Typo.h2" Class="card-data">
                                        @(AdminDashboardCount.TotalRegisteredTrainers)
                                    </MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Error" Class="rate d-flex align-items-center gap-3">
                                        <MudImage Src="images/icons/graph-down.svg" Height="24" Width="24" Alt="Graph Arrow Down" />
                                        @(AdminDashboardCount.TotalRegisteredCandidatesGrowth) %
                                    </MudText>
                                </div>
                            </div>
                        </div>
                        <div class="item col-xxl-3 col-lg-3 col-md-6 col-12">
                            <div class="card">
                                <MudText Typo="Typo.subtitle1" Class="mb-4 card-title text-normal">
                                    Total Pending Requests
                                </MudText>
                                <div class="d-flex align-items-center justify-content-between">
                                    <MudText Typo="Typo.h2" Class="card-data">
                                        @(AdminDashboardCount.TotalPendingRequests)
                                    </MudText>
                                    <MudText Typo="Typo.body1" Color="Color.Error" Class="rate d-flex align-items-center gap-3">
                                        <MudImage Src="images/icons/graph-down.svg" Height="24" Width="24" Alt="Graph Arrow Down" />
                                        @(AdminDashboardCount.TotalPendingRequestsGrowth) %
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="box available-training mb-6">
                    <div class="mb-4 available-training__head">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-bold text-dark">Upcoming Trainings</MudText>
                        <MudText Typo="Typo.body1" Class="hfs6 fw-600 subtitle">Here are a few upcoming trainings and their respective details.</MudText>
                    </div>
                    <div class="row gap-y-5 available-training-grid">
                        @foreach (var training in UpcomingTrainings)
                        {
                            <div class="col-xxl-3 col-lg-6 col-sm-6 col-12">
                                <MudCard Class="available-training-card custom-card pa-4 h-100 d-flex flex-column" Elevation="0">
                                    @if (string.IsNullOrEmpty(training.ImageUrl))
                                    {
                                        <MudImage Src="images/dummy-img.png" Height="208" Width="330" Class="img-fluid w-100 card__image" />
                                    }
                                    else
                                    {
                                        <MudImage Src="@training.ImageUrl" Height="208" Width="330" Class="img-fluid w-100 card__image" />
                                    }
                                    <MudCardContent Class="pa-0">
                                        <MudPaper Elevation="0" Class="d-flex justify-content-between align-items-center mb-2 bg-transparent">
                                            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="text-dark fw-bold">@training.Title</MudText>
                                        </MudPaper>
                                        <div style="height: 40px; overflow: hidden;">
                                            <MudText Typo="Typo.body2" Class="text-normal">
                                                @((MarkupString)training.Description)
                                            </MudText>
                                        </div>
                                        <MudDivider Class="my-3" />
                                        <AssignedTrainerDetails AssignedTrainers="@training.AssignedTrainers" />
                                        <div class="date d-flex align-items-center gap-x-2 mb-3">
                                            <MudImage Src="images/icons/calendar.svg" Alt="Blue Calendar Icon" Width="20" Height="20" />
                                            <MudText Typo="Typo.subtitle2" Class="text-normal">@training.Date</MudText>
                                        </div>
                                        <div class="location d-flex align-items-center gap-x-2">
                                            <MudImage Src="images/icons/location.svg" Alt="Blue Location Icon" Width="20" Height="20" />
                                            <MudText Typo="Typo.subtitle2" Class="text-normal">@training.Location</MudText>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </div>
                        }
                    </div>
                </div>

                <div class="graph box mb-5">
                    <div class="mb-4 available-training__head">
                        <div class="filter d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
                            <div class="filter-left gap-x-2">
                                <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-bold text-dark">Training Summary</MudText>
                                <MudText Typo="Typo.body1" Class="hfs6 fw-600 subtitle">View all the trainings for the following year and their respective start dates.</MudText>
                            </div>
                            <div class="filter-right">
                                <div class="dropdown">
                                    <MudSelect T="int"
                                               Label="Select a Year"
                                               Variant="Variant.Text"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Value="@SelectedYear"
                                               ValueChanged="@OnYearChanged">
                                        @foreach (var year in Years)
                                        {
                                            <MudSelectItem T="int" Value="@year">@year</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="graph-representation col-xxl-8 col-xl-10 col-12 mx-auto">
                        @if (IsTriggered)
                        {
                            <ApexChart @ref="ChartData" TItem="TrainingStartDateSummary" Height="500" Options="_chartOptions">
                                @foreach (var trainingGroup in new[]
                                {
                                    TrainingRequestsSummary.FirstTraining,
                                    TrainingRequestsSummary.SecondTraining,
                                    TrainingRequestsSummary.ThirdTraining,
                                    TrainingRequestsSummary.FourthTraining,
                                    TrainingRequestsSummary.FifthTraining
                                })
                                {
                                    if (trainingGroup.Any())
                                    {
                                        <ApexPointSeries TItem="TrainingStartDateSummary"
                                                         Items="@trainingGroup.Select(e => new TrainingStartDateSummary { Month = e.Month, Date = e.Date, Title = e.Title }).ToList()"
                                                         Name="Title"
                                                         Group="@string.Join(",", trainingGroup.Select(e => e.Title))"
                                                         XValue="@(e => e.Month)"
                                                         YValue="@(e => e.Date)"
                                                         SeriesType="SeriesType.Bar" />
                                    }
                                }
                            </ApexChart>
                        }
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </div>
</div>
