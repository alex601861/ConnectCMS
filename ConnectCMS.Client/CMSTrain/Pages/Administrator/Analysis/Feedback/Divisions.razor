@page "/feedbacks/divisions"
@attribute [Authorize]

<PageTitle>@Layout.PageTitle</PageTitle>

<div>
    <MudTabs Elevation="0" @bind-ActivePanelIndex="ActivePanelIndex" Class="gap-3">
        <MudTabPanel Text="Divisions" BadgeData="@HeadingCount.HeadingCount" BadgeColor="Color.Secondary">
            @if (ActivePanelIndex == 0)
            {
                <Heading HeadingType="HeadingType.Heading" FacetType="FacetType.Division" InspectionType="InspectionType.Feedback" OnHeadingCountUpdate="EventCallback.Factory.Create(this, HandleHeadersCount)"/>
            }
        </MudTabPanel>
        <MudTabPanel Text="Sub Divisions" BadgeData="@HeadingCount.SubHeadingCount" BadgeColor="Color.Secondary">
            @if (ActivePanelIndex == 1)
            {
                <Heading HeadingType="HeadingType.SubHeading" FacetType="FacetType.Division" InspectionType="InspectionType.Feedback" OnHeadingCountUpdate="EventCallback.Factory.Create(this, HandleHeadersCount)"/>
            }
        </MudTabPanel>
    </MudTabs>
</div>