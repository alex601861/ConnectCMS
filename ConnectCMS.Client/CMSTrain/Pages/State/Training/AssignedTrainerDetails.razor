<div class="d-flex justify-content-between align-items-center gap-3 mb-3">
    <div class="d-flex align-items-center">
        @if (AssignedTrainers.Trainers.Any())
        {
            <MudAvatarGroup Max="3" Class="avatar d-flex align-items-center">
                @foreach (var trainer in AssignedTrainers.Trainers)
                {
                    <div class="@(AssignedTrainers.Trainers.IndexOf(trainer) == 0 ? "" : "ms-n3")" style="z-index: 1">
                        <MudTooltip Text="@trainer.Name" Color="Color.Primary" Arrow="true">
                            <Avatar Height="44"
                                    Width="44"
                                    Name="@trainer.Name"
                                    FilePath="@Constants.FilePath.UsersImagesFilePath"
                                    ImageUrl="@trainer.ImageUrl" />
                        </MudTooltip>
                    </div>
                }
            </MudAvatarGroup>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="text-normal">No assigned trainers.</MudText>
        }
    </div>

    <div>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="btn px-4 py-2 fw-500 class-count" DropShadow="false">
            @AssignedTrainers.ClassCount
        </MudButton>
    </div>
</div>