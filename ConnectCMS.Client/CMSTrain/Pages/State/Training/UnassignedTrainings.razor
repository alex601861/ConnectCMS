<PageTitle>@Layout.PageTitle</PageTitle>

<Back NavigationUrl="@UnAssignedTrainingsNavigation"/>

<MudTabs Elevation="0" PanelClass="bg-white" @bind-ActivePanelIndex="ActivePanelIndex" Class="gap-3">
    <MudTabPanel Text="Training Details">
        @if (ActivePanelIndex == 0)
        {
            <CMSTrain.Client.Pages.State.Training.Details.TrainingDetails 
                TrainingId="TrainingId"/>
        }
    </MudTabPanel>
    <MudTabPanel Text="Class Details" BadgeColor="Color.Secondary" BadgeData="@TrainingDetailsCountDto.ClassDetailsCount">
        @if (ActivePanelIndex == 1)
        {
            <CMSTrain.Client.Pages.State.Training.Details.ClassDetails 
                TrainingId="TrainingId"/>
        }
    </MudTabPanel>
</MudTabs>
