<div class="class-details-card custom-card mb-6">
    <div class="d-flex align-items-center flex-wrap flex-sm-nowrap gap-y-5 gap-x-6">
        <div style="width: 207px">
            <MudImage Src="@Training.ImageUrl" Height="140" Width="207" Class="img-fluid w-100 card__image" />
        </div>
        <div class="w-auto">
            <MudCardContent Class="pa-0 d-flex flex-column gap-3">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-bold">@Training.Title</MudText>
                <MudText Typo="Typo.body1" class="form-desc">
                    @((MarkupString)Training.Description)
                </MudText>
                <div>
                    <div class="date d-flex align-items-center gap-x-2 mb-2">
                        <MudImage Src="images/icons/calendar.svg" Alt="Blue Calendar Icon" Width="20" Height="20" />
                        <MudText Typo="Typo.subtitle2" Class="text-normal">@Training.StartDate - @Training.EndDate</MudText>
                    </div>
                    <div class="time d-flex align-items-center gap-x-2">
                        <MudImage Src="images/icons/clock.svg" Alt="Blue Clock Icon" Width="20" Height="20" />
                        <MudText Typo="Typo.subtitle2" Class="text-normal">@Training.LocationDetails</MudText>
                    </div>
                </div>
            </MudCardContent>
        </div>
    </div>
</div>
