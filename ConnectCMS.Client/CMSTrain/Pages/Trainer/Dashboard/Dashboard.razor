@page "/home/trainer-dashboard"
@attribute [Authorize]

<PageTitle>@Layout.PageTitle</PageTitle>

<div class="dashboard trainer-dashboard">
    <div class="dashboard-header d-flex align-items-center justify-content-between flex-wrap mb-6">
        <div class="dashboard-header-text col-10">
            <MudText Typo="Typo.h6" Class="fw-bold text-dark">
                Namaste @UserDetail.Name 🙏 -
                <MudText Typo="Typo.subtitle2" HtmlTag="span" Class="text-normal">here’s what’s happening with your dashboard</MudText>
            </MudText>
        </div>
        <div class="col-2">
            <TimePeriodFilter Value="TimePeriod" ValueChanged="OnStatusFilter" />
        </div>
    </div>

    <div class="dashboard__grid mb-5">
        <div class="dashboard__grid-left">
            <div class="data-card-wrapper mb-6">
                <div class="grid row gap-y-4">
                    <div class="item col-xxl-4 col-lg-4 col-md-6 col-12">
                        <div class="card">
                            <MudText Typo="Typo.subtitle1" Class="mb-4 card-title text-normal">
                                Attendances
                            </MudText>
                            <div class="d-flex align-items-center justify-content-between">
                                <MudText Typo="Typo.h2" Class="card-data">
                                    @TrainerDashboardCount.PendingAttendances
                                </MudText>
                                <MudText Typo="Typo.body1" Color="Color.Success" Class="rate d-flex align-items-center gap-3">
                                    <MudImage Src="images/icons/graph-up.svg" Height="24" Width="24" Alt="Graph Arrow Up" />
                                    @TrainerDashboardCount.PendingAttendancesGrowth %
                                </MudText>
                            </div>
                        </div>
                    </div>
                    <div class="item col-xxl-4 col-lg-4 col-md-6 col-12">
                        <div class="card">
                            <MudText Typo="Typo.subtitle1" Class="mb-4 card-title text-normal">
                                Assigned Classes
                            </MudText>
                            <div class="d-flex align-items-center justify-content-between">
                                <MudText Typo="Typo.h2" Class="card-data">
                                    @TrainerDashboardCount.TotalAssignedClass
                                </MudText>
                                <MudText Typo="Typo.body1" Color="Color.Error" Class="rate d-flex align-items-center gap-3">
                                    <MudImage Src="images/icons/graph-down.svg" Height="24" Width="24" Alt="Graph Arrow Down" />
                                    @TrainerDashboardCount.TotalAssignedClassGrowth %
                                </MudText>
                            </div>
                        </div>
                    </div>
                    <div class="item col-xxl-4 col-lg-4 col-md-6 col-12">
                        <div class="card">
                            <MudText Typo="Typo.subtitle1" Class="mb-4 card-title text-normal">
                                Inspections
                            </MudText>
                            <div class="d-flex align-items-center justify-content-between">
                                <MudText Typo="Typo.h2" Class="card-data">
                                    @TrainerDashboardCount.TotalGradedInspections
                                </MudText>
                                <MudText Typo="Typo.body1" Color="Color.Error" Class="rate d-flex align-items-center gap-3">
                                    <MudImage Src="images/icons/graph-down.svg" Height="24" Width="24" Alt="Graph Arrow Down" />
                                    @TrainerDashboardCount.TotalGradedInspectionsGrowth %
                                </MudText>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="graph box mb-6">
                <div class="mb-4 active-training__head">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-bold text-dark mb-1">Present Classes</MudText>
                    <MudText Typo="Typo.body1" Class="hfs6 fw-600 subtitle">Here are some of the classes for today, yesterday and tomorrow.</MudText>
                </div>
                <div class="graph-representation col-xxl-8 col-xl-10 col-12 mx-auto">
                    @if (IsTriggered)
                    {
                        <BarChart T="GetTotalClasses"
                                  Items="@TrainerTotalClasses"
                                  IsHorizontallyAligned="false"
                                  Height="450"
                                  Width="650"
                                  Title="Total Classes"
                                  MaxYValue="5"
                                  ShowLegend="false"
                                  XValue="@(e => $"{e.Date} ({e.DayOfWeek})")"
                                  YValue="@(e => e.Sum(z => (decimal)z.ClassCount))" />
                    }
                </div>
            </div>
            
            <div class="box active-training mb-6">
                <div class="mb-4 active-training__head">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-bold text-dark">Active Trainings</MudText>
                    <MudText Typo="Typo.body1" Class="hfs6 fw-600 subtitle">Here are some of the new happening active available trainings.</MudText>
                </div>
                <div class="row gap-y-5 active-training-grid">
                    @foreach (var activeTrainings in TrainerActiveTraining)
                    {
                        <div class="col-xxl-4 col-lg-6 col-sm-6 col-12">
                            <MudCard Class="available-training-card custom-card pa-4 h-100 d-flex flex-column" Elevation="0">
                                @if (string.IsNullOrEmpty(activeTrainings.ImageUrl))
                                {
                                    <MudImage Src="images/dummy-img.png" Height="208" Width="330" Class="img-fluid w-100 card__image" />
                                }
                                else
                                {
                                    <MudImage Src="@activeTrainings.ImageUrl" Height="208" Width="330" Class="img-fluid w-100 card__image" />
                                }
                                <MudCardContent Class="pa-0">
                                    <MudPaper Elevation="0" Class="d-flex justify-content-between align-items-center mb-2 bg-transparent">
                                        <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="text-dark fw-bold">@activeTrainings.Title</MudText>
                                    </MudPaper>
                                    <div style="height: 40px; overflow: hidden;">
                                        <MudText Typo="Typo.body2" Class="text-normal">
                                            @((MarkupString)activeTrainings.Description)
                                        </MudText>
                                    </div>
                                    <MudDivider Class="my-3" />
                                    <AssignedTrainerDetails AssignedTrainers="@activeTrainings.AssignedTrainers" />
                                    <div class="date d-flex align-items-center gap-x-2 mb-3">
                                        <MudImage Src="images/icons/calendar.svg" Alt="Blue Calendar Icon" Width="20" Height="20"/>
                                        <MudText Typo="Typo.subtitle2" Class="text-normal">@activeTrainings.Date</MudText>
                                    </div>
                                    <div class="location d-flex align-items-center gap-x-2">
                                        <MudImage Src="images/icons/location.svg" Alt="Blue Location Icon" Width="20" Height="20"/>
                                        <MudText Typo="Typo.subtitle2" Class="text-normal">@activeTrainings.LocationDetails</MudText>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="dashboard__grid-right box">
            <div class="row gap-y-8">
                <div class="col-lg-12 col-md-6 col-12">
                    <div class="calendar">
                        <MudDatePicker Label="Select Date"
                                       PickerVariant="PickerVariant.Static"
                                       @bind-Date="DateRequest"
                                       @bind-Date:after="OnDateChanged"
                                       DateFormat="dd.MM.yyyy"
                                       AdditionalDateClassesFunc="CheckDate"
                                       Style="width: 100%;" />
                    </div>
                </div>

                <div class=" col-lg-12 col-md-6 col-12">
                    <div class="class-list pt-4" Style="border-top: 1px solid #D0C2C2">
                        <div class="mt-4">
                            @if (TrainerClassesForDates.Any())
                            {
                                <MudGrid Spacing="4" Class="popular-courses__grid">
                                    @foreach (var classModel in TrainerClassesForDates)
                                    {
                                        <MudItem xs="12" Class="popular-courses__grid-item" @onclick="() => NavigateToClassDetails(classModel.ClassId)" Style="cursor:pointer">
                                            <MudCard Elevation="0" Class="course-card">
                                                <MudCardContent>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="card-image">
                                                            <MudImage Src="@classModel.ClassImage" alt="Dummy Image" Height="112" Width="112" Class="img-fluid" />
                                                        </div>
                                                        <div class="card-text">
                                                            <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="text-dark course-name mb-1 fw-bolder">@classModel.Title</MudText>
                                                            <MudText Typo="Typo.body2" Class="text-normal fw-bold">@classModel.TrainingName</MudText>
                                                            <MudText Typo="Typo.body2" Class="text-normal date fs-12 mb-1">@classModel.ClassDate (@classModel.ClassDay)</MudText>
                                                            <MudText Typo="Typo.body2" Class="text-normal">@classModel.StartTime - @classModel.EndTime</MudText>
                                                        </div>
                                                    </div>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudItem>
                                    }
                                </MudGrid>
                            }
                            else
                            {
                                <div class="text-center">
                                    <MudText Typo="Typo.body2" class="fs12 desc">No classes allocated for the selected date.</MudText>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="assigned-trainee custom-table box">
        <div class="custom-table__header d-flex align-items-center justify-content-between mb-5 flex-wrap gap-y-3">
            <div>
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-bold text-dark mb-1">Assigned Trainings</MudText>
                <MudText Typo="Typo.body1" Class="hfs6 fw-600 subtitle">Here are some of the new happening active available trainings.</MudText>    
            </div>
            @* <div class="d-flex align-items-center gap-x-2 filter"> *@
            @*     <MudTextField @bind-Value="Search" Placeholder="Search" Variant="Variant.Text" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="search-input text-dark"/> *@
            @*     <MudImage Src="images/icons/filter.svg" Alt="Filter Icon" Width="46" Height="46" Class="img-fluid w-auto"/> *@
            @* </div> *@
        </div>
        <div class="table-responsive">
            <table class="table assigned-trainee-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Training</th>
                        <th>Location</th>
                        <th>Class</th>
                        <th>Next Class Date</th>
                        <th>Time Period</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in TrainerUpcomingClassDetails)
                {
                    <tr>
                        <td>@(TrainerUpcomingClassDetails.IndexOf(item) + 1).</td>
                        <td>@item.TrainingName</td>
                        <td>@item.Location</td>
                        <td>@item.ClassDate (@item.ClassDay)</td>
                        <td>@item.StartTime - @item.EndTime</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>