<div class="banner flex-wrap flex-sm-nowrap d-flex align-items-center gap-3 pa-5">
    <div class="banner__image">
        <MudImage Src="images/icons/paper.svg" Alt="Personality Test" Height="112" Width="118" Class="img-fluid" />
    </div>
    <div class="banner__text">
        <MudText Typo="Typo.h6" HtmlTag="h2" Color="Color.Primary" Class="fw-bold mb-2">
            What is @PersonalityTrait.Type?
        </MudText>
        <MudText Typo="Typo.body2" Class="text-normal">
            @PersonalityTrait.Description
        </MudText>
    </div>
</div>