@page "/personality-test-response/{UserResponseId:guid}"
@attribute [Authorize]

<PageTitle>@Layout.PageTitle</PageTitle>

<Back NavigationUrl="@($"/admin/questionnaire-view-form/{PersonalityTestResponse.QuestionnaireId}")"/>

<div class="personality-test">
    <div class="col-xxl-8 col-xl-10 col-12 mx-auto">
        <div class="title mb-8">
            <div class="d-flex align-items-center justify-content-between">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="text-dark fw-bold mb-2">Personality Test</MudText>
                <MudTooltip Text="Analysis" Color="Color.Primary" Arrow="true">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="btn custom-btn" DropShadow="false" OnClick="NavigateToPersonalityTestAnalysis" StartIcon="@Icons.Material.Filled.Info">
                        View Analysis
                    </MudButton>
                </MudTooltip>
            </div>
            <MudText Typo="Typo.body2" Class="text-normal">View your answer reports regarding your responses to the following personality test.</MudText>
        </div>
        <div class="personality-stepper-form mb-5">
            <div class="stepper-body">
                <MudTabs Elevation="0" @bind-ActivePanelIndex="ActivePanelIndex" Class="gap-3">
                    @foreach (var item in PersonalityTestResponse.QuestionnaireTraits)
                    {
                        <MudTabPanel Text="@item.Trait"
                                     BadgeColor="Color.Secondary"
                                     BadgeData="@item.QuestionCount">
                            @if (ActivePanelIndex == PersonalityTestResponse.QuestionnaireTraits.IndexOf(item))
                            {
                                <PersonalityTestViewForm Trait="@item.Trait"
                                                           Facets="item.Facets" />
                            }
                        </MudTabPanel>
                    }
                </MudTabs>
            </div>
        </div>
        <div class="form-btn d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
            <div class="form-btn__left">
                @if (ActivePanelIndex > 0)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Class="btn btn--md"
                               DropShadow="false"
                               Disabled="@(ActivePanelIndex == 0)"
                               OnClick="@(() => NavigateTabs(false))">
                        Previous
                    </MudButton>
                }
            </div>
            <div class="form-btn__right">
                @if (ActivePanelIndex < PersonalityTestResponse.QuestionnaireTraits.Count - 1)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="btn btn--md"
                               DropShadow="false"
                               OnClick="@(() => NavigateTabs(true))">
                        Next
                    </MudButton>
                }
            </div>
        </div>
    </div>
</div>