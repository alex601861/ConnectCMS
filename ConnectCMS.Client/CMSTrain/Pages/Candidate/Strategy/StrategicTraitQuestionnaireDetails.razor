<MudPaper Outlined="true" class="inner-bg">
    <div class="title mb-6">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="text-dark mb-2">SWOT Analysis</MudText>
        <MudText Typo="Typo.body2" Class="text-normal">@Description</MudText>
    </div>
    <div class="inner-padding bg-white pa-4 mb-6">
        <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="text-dark fw-bold mb-4">
            <MudImage Src="@Icon" Alt="Icon" Width="24" Height="24" />
            @Title
        </MudText>
        <div class="inner-padding pa-3 mb-4">
            <MudText Typo="Typo.body1" Class="text-dark">
                What do you do well? What unique resources can you draw on? What do others see as your @Title.ToLower()?
            </MudText>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-x-6 gap-y-7">
            @foreach (var trait in Traits)
            {
                <MudTooltip Text="@(((MarkupString)trait.Description).ToString())" Class="cursor-pointer">
                    @if (SelectedTraitIds.Contains(trait.Id))
                    {
                        <div class="checked d-flex align-items-center gap-x-2" @onclick="() => SelectTrait(trait.Id, false, StrategicType)">
                            <MudTooltip Text="@trait.Description" Color="Color.Primary" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckBox" aria-label="delete" Color="Color.Primary" Class="pa-0"/>
                            </MudTooltip>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold" Color="Color.Primary">@trait.Name</MudText>
                        </div>
                    }
                    else
                    {
                        <div class="unchecked d-flex align-items-center gap-x-2" @onclick="() => SelectTrait(trait.Id, true, StrategicType)">
                            <MudTooltip Text="@trait.Description" Color="Color.Primary" Arrow="true">
                                <MudIconButton Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" aria-label="delete" Class="pa-0"/>
                            </MudTooltip>
                            <MudText Typo="Typo.subtitle2" Class="text-dark fw-bold">@trait.Name</MudText>
                        </div>
                    }
                </MudTooltip>
            }
        </div>
    </div>
</MudPaper>