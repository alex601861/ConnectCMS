<div class="inner-padding bg-white pa-4 mb-6">
    <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="text-dark fw-bold mb-4">
        <MudImage Src="@Icon" Alt="Icon" Width="24" Height="24" />
        @Title
    </MudText>
    <div class="inner-padding pa-3 mb-4">
        <MudText Typo="Typo.body1" Class="text-dark">
            What do you do well? What unique resources can you draw on? What do others see as your @Title.ToLower()?
        </MudText>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-x-6 gap-y-7">
        @foreach (var item in Traits)
        {
            <MudTooltip Text="@item.Description">
                @if (item.IsSelected)
                {
                    <div class="checked">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">@item.Name</MudText>
                    </div>
                }
                else
                {
                    <div class="unchecked">
                        <MudText Typo="Typo.subtitle2" Class="text-dark fw-bold">@item.Name</MudText>
                    </div>
                }
            </MudTooltip>
        }
    </div>
</div>
