@page "/assessment-evaluation-form/{QuestionnaireId:guid}/{UserResponseId:guid}"
@attribute [Authorize]

<PageTitle>@Layout.PageTitle</PageTitle>

<Back />

<div class="question-answer-form">
    <div class="mb-2">
        @if (TrainingInspectionDetails.InspectionId != Guid.Empty)
        {
            <InspectionViewDetails InspectionId="@TrainingInspectionDetails.InspectionId"/>
        }
    </div>
    <div class="d-flex">
        <div class="col-10">
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="text-dark mb-2">
                Analytics and Insights
            </MudText>
            <MudText Typo="Typo.body2" Class="text-normal mb-6">
                View the comparision of the details of the personal assessment of the candidate with his / her respective subordinates.
            </MudText>
        </div>
        <div class="col-2">
            <MudSelect T="bool" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" ValueChanged="OnSubordinateEvaluationChange">
                <MudSelectItem Value="false">Candidates</MudSelectItem>
                <MudSelectItem Value="true">Subordinates</MudSelectItem>
            </MudSelect>
        </div>
    </div>
    <MudTabs Elevation="0" Class="gap-3">
        @for (var i = 1; i <= PhaseCounts; i++)
        {
            var index = i;
            var mudPanelText = $"Phase {index}";
            
            <MudTabPanel Text="@mudPanelText" Icon="@Icons.Material.Filled.TransitEnterexit" OnClick="() => OnPhaseChange(index)">
                <div class="custom-table inner-padding">
                    <div class="table-responsive" style="overflow-x: scroll">
                        <table class="table strategic-trait-table">
                            <thead>
                            <tr>
                                <th style="width:5%">#</th>
                                <th style="min-width: 300px">Question</th>
                                <th>Statistics</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var response in AssessmentResponseAnalysis)
                            {
                                <tr>
                                    <td>@(AssessmentResponseAnalysis.IndexOf(response) + 1).</td>
                                    <td>
                                        <MudText Typo="Typo.body2" Class="text-normal">
                                            @response.Question
                                        </MudText>
                                    </td>
                                    <td>
                                        @if (response.QuestionType != QuestionType.LongQuestion.ToString() && response.QuestionType != QuestionType.ShortQuestion.ToString())
                                        {
                                            var height = IsSubordinateRequired ? "170" : "120";
                                            <BarChart T="ResponseAnalysis"
                                                      Items="response.Responses"
                                                      Title="Scores"
                                                      Height="@height"
                                                      MaxYValue="5"
                                                      Width="500"
                                                      ShowLegend="IsSubordinateRequired"
                                                      XValue="@(e => e.Respondent)"
                                                      YValue="@(e => e.Sum(z => (decimal)z.Score))"/>
                                        }
                                        else
                                        {
                                            foreach (var responseModel in response.Responses)
                                            {
                                                <MudText Typo="Typo.body2" Class="text-normal mb-4">
                                                    @responseModel.Respondent
                                                </MudText>
                                                <MudTextField T="string" @bind-Value="responseModel.Responses" Variant="Variant.Outlined" ReadOnly="true" Class="mb-6"/>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </MudTabPanel>
        }
    </MudTabs>
</div>