@page "/feedback-details-form/{UserResponseId:guid}"
@attribute [Authorize]

<PageTitle>@Layout.PageTitle</PageTitle>

<Back />

<div class="question-answer-form">
    @if (TrainingDetails.Id != Guid.Empty)
    {
        <TrainingViewDetails TrainingId="@TrainingDetails.Id"/>
    }
    <MudTabs Elevation="0" PanelClass="bg-white" Class="gap-3">
        <MudTabPanel Text="Responses" Icon="@Icons.Material.Filled.QuestionAnswer" BadgeColor="Color.Secondary">
            <UserResponseDetails UserResponseId="UserResponseId" />
        </MudTabPanel>
        <MudTabPanel Text="Analysis" Icon="@Icons.Material.Filled.Analytics" BadgeColor="Color.Secondary">
            <UserResponseAnalysis UserResponseId="UserResponseId" />
        </MudTabPanel>
    </MudTabs>
</div>