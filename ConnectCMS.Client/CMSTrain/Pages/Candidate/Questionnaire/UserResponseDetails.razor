<div class="inner-bg">
    <div class="d-flex justify-content-between align-items-center">
        <MudText Typo="Typo.h6" HtmlTag="h3" Class="text-dark mb-2">
            @Inspection.Name
        </MudText>
        <MudTooltip Arrow="true" Text="Inspection Details" Color="Color.Primary" Placement="Placement.Left">
            <MudIcon Icon="@Icons.Material.Filled.Info" @onclick="OpenCloseInspectionModal"/>
        </MudTooltip>
    </div>
    
    <MudText Typo="Typo.body2" Class="text-normal mb-6">
        View the respective answers and responses of the following inspection.
    </MudText>
    <form class="form-wrapper">
        @foreach (var question in AnswerDetails.QuestionAnswers)
        {
            <div class="form-content">
                @if (!string.IsNullOrEmpty(question.Heading))
                {
                    <div class="custom-breadcrumb">
                        <MudText Typo="Typo.h6" HtmlTag="span" Class="text-dark fw-bold">
                            @question.Heading
                        </MudText>
                    </div>
                }
                <div class="question">
                    <MudText Typo="Typo.body1" HtmlTag="h4" Class="text-dark fw-500">
                        @question.Title
                        <MudText HtmlTag="sup" Class="top-0" Color="Color.Error">*</MudText>
                    </MudText>
                </div>
                <div class="answer">
                    @if (question.QuestionType == QuestionType.SingleSelectMcq.ToString())
                    {
                        if (Inspection.Type != InspectionType.Feedback.ToString())
                        {
                            <div class="d-flex align-items-center gap-x-5">
                                <MudText Typo="Typo.subtitle2" Class="text-light">@question.Answers.First().Title</MudText>
                                <div class="d-flex justify-content-between align-items-center gap-x-7">
                                    @for (var i = 0; i < question.Answers.Count; i++)
                                    {
                                        var answer = question.Answers[i];
                                        var size = i == 0 || i == question.Answers.Count - 1
                                            ? Size.Large
                                            : i == 1 || i == question.Answers.Count - 2
                                                ? Size.Medium
                                                : Size.Small;

                                        var color = i switch
                                        {
                                            0 => Color.Success,
                                            1 => Color.Success,
                                            2 => Color.Info,
                                            _ => Color.Error
                                        };

                                        <MudIconButton Icon="@(answer.IsSelected ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" aria-label="delete" Color="@color" Size="@size" Class="pa-0"/>
                                    }
                                </div>
                                <MudText Typo="Typo.subtitle2" Class="text-light">@question.Answers.Last().Title</MudText>
                            </div>
                        }
                        else
                        {
                            <div class="custom-radio-btn">
                                @foreach (var answer in question.Answers)
                                {
                                    <div class="mud-input-control mud-input-control-boolean-input mb-2">
                                        <div class="checked d-flex align-items-center gap-x-2">
                                            <MudIconButton Icon="@(answer.IsSelected ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" aria-label="delete" Color="Color.Secondary" Class="pa-0"/>
                                            <MudText Typo="Typo.subtitle1">@answer.Title</MudText>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (question.QuestionType == QuestionType.MultiSelectMcq.ToString())
                    {
                        <div class="custom-radio-btn">
                            @foreach (var answer in question.Answers)
                            {
                                <div class="mud-input-control mud-input-control-boolean-input mb-2">
                                    <div class="checked d-flex align-items-center gap-x-2">
                                        <MudIconButton Icon="@(answer.IsSelected ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" aria-label="delete" Color="Color.Secondary" Class="pa-0"/>
                                        <MudText Typo="Typo.subtitle1">@answer.Title</MudText>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        var answer = question.Answers.First();

                        if (question.QuestionType == QuestionType.Rating.ToString())
                        {
                            <MudRating @bind-SelectedValue="answer.Rating" MaxValue="5" ReadOnly="true"/>
                        }
                        else if (question.QuestionType == QuestionType.ShortQuestion.ToString())
                        {
                            <MudTextField T="string" @bind-Value="answer.Title" Variant="Variant.Outlined" Placeholder="Please enter your answer..." ReadOnly="true"/>
                        }
                        else if (question.QuestionType == QuestionType.LongQuestion.ToString())
                        {
                            <MudTextField T="string" @bind-Value="answer.Title" Variant="Variant.Outlined" Placeholder="Please enter your answer..." Lines="7" ReadOnly="true"/>
                        }
                    }
                </div>
            </div>
        }
        <MudDivider Class="my-3" Style="border-color: #000000"/>
        <div class="form-content">
            <div class="custom-breadcrumb">
                <MudText Typo="Typo.h6" HtmlTag="span" Class="text-dark fw-bold">
                    Remarks
                </MudText>
            </div>
            <div class="answer">
                <MudTextField T="string" @bind-Value="AnswerDetails.Remarks" Variant="Variant.Outlined" Placeholder="Please provide your remarks here ..." Lines="7" ReadOnly="true"/>
            </div>
        </div>
    </form>
    
    @if (IsInspectionModalOpen)
    {
        <ModalLayout T="@GetInspectionDto"
                     Module="Inspection Module"
                     Title="@Inspection.Name"
                     Description="View the details of the respective inspection."
                     SubmitColor="Color.Primary"
                     Size="modal-lg"
                     OnSave="@OpenCloseInspectionModal"
                     CancelLabel="Discard">
            <InspectionViewDetails InspectionId="@Inspection.Id"/>
        </ModalLayout>
    }
</div>