@if (TrainingRequestForCandidate == null)
{
    <Loader />
}
else
{
    <div class="inner-padding training">
        <div class="filter d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
            <div class="filter-left d-flex align-items-center gap-x-2">
                <MudTextField T="string" @bind-Value="Search" Immediate="true" Placeholder="Search" Variant="Variant.Text" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="search-input text-dark" />
            </div>
        </div>

        <div class="training-grid row gap-y-5">
            @foreach (var training in TrainingRequestForCandidate.Result)
            {
                <div class="col-xxl-3 col-lg-4 col-md-6 col-12">
                    <MudCard Class="training-card custom-card" Elevation="0">
                        <MudImage Src="@training.TrainingDetails.ImageUrl" Width="207" Height="140" Class="img-fluid w-100" />
                        <MudCardContent Class="pa-0">
                            <MudPaper Elevation="0" Class="d-flex justify-content-between align-items-center mb-2 bg-transparent">
                                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="text-dark fw-bold">@training.TrainingDetails.Title</MudText>
                            </MudPaper>
                            <MudText Typo="Typo.body2" Class="text-normal">
                                @((MarkupString)training.TrainingDetails.Description)
                            </MudText>
                            <MudDivider Class="my-3"/>
                            <AssignedTrainerDetails AssignedTrainers="@training.TrainingDetails.AssignedTrainers"/>
                            <div class="date d-flex align-items-center gap-x-2 mb-3">
                                <MudImage Src="images/icons/calendar.svg" Alt="Blue Calendar Icon" Width="20" Height="20"/>
                                <MudText Typo="Typo.subtitle2" Class="text-normal">@training.TrainingDetails.StartDate - @training.TrainingDetails.EndDate</MudText>
                            </div>
                            <div class="location d-flex align-items-center gap-x-2">
                                <MudImage Src="images/icons/location.svg" Alt="Blue Location Icon" Width="20" Height="20"/>
                                <MudText Typo="Typo.subtitle2" Class="text-normal">@training.TrainingDetails.LocationDetails</MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </div>
            }
        </div>

        <Pagination PageCount="TrainingRequestForCandidate.TotalPages"
                    SelectedPageSize="@PageSize"
                    SelectedPageSizeChanged="UpdatePageSize"
                    SelectedPageNumber="@PageNumber"
                    SelectedPageNumberChanged="UpdatePageNumber"
                    TotalRecords="TrainingRequestForCandidate.TotalCount" />
    </div>
}
