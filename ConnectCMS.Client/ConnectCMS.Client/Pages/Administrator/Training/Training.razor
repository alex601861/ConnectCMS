@page "/trainings"
@attribute [Authorize]

<PageTitle>@Layout.PageTitle</PageTitle>

<div>
    <MudTabs Elevation="0" @bind-ActivePanelIndex="ActivePanelIndex" Class="gap-3">
        <MudTabPanel Text="Active" BadgeColor="Color.Secondary" BadgeData="@TrainingModuleCountDto.AvailableCount">
            @if (ActivePanelIndex == 0)
            {
                <TrainingList StatusAction="Constants.StatusAction.Available" OnTrainingsCountUpdate="HandleTrainingCounts" />
            }
        </MudTabPanel>
        <MudTabPanel Text="Expired" BadgeColor="Color.Secondary" BadgeData="@TrainingModuleCountDto.ExpiredCount">
            @if (ActivePanelIndex == 1)
            {
                <TrainingList StatusAction="Constants.StatusAction.Expired" OnTrainingsCountUpdate="HandleTrainingCounts" />
            }
        </MudTabPanel>
        <MudTabPanel Text="All" BadgeColor="Color.Secondary" BadgeData="@TrainingModuleCountDto.AllCount">
            @if (ActivePanelIndex == 2)
            {
                <TrainingList StatusAction="Constants.StatusAction.All" OnTrainingsCountUpdate="HandleTrainingCounts" />
            }
        </MudTabPanel>
    </MudTabs>
</div>