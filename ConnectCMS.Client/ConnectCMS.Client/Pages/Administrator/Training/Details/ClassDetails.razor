@if (Classes == null)
{
    <Loader/>
}
else
{
    <div class="class-details inner-padding">
        <div class="filter d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
            <div class="filter-left d-flex align-items-center gap-x-2">
                <MudTextField T="string" @bind-Value="Search" Immediate="true" Placeholder="Search" Variant="Variant.Text" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="search-input text-dark"/>
                <Filter OnFilterApplication="OnClassDetailsFilter">
                    <MudSelect T="int?" @bind-Value="Status" Label="Status" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@(Constants.Schedule.All)">@Constants.Schedule.AllAction</MudSelectItem>
                        <MudSelectItem Value="@(Constants.Schedule.Scheduled as int?)">@Constants.Schedule.ScheduledAction</MudSelectItem>
                        <MudSelectItem Value="@(Constants.Schedule.InProgress as int?)">@Constants.Schedule.InProgressAction</MudSelectItem>
                        <MudSelectItem Value="@(Constants.Schedule.Completed as int?)">@Constants.Schedule.CompletedAction</MudSelectItem>
                    </MudSelect>
                </Filter>
            </div>
            <div class="filter-right">
                <DisplayFormat IsDisplayedAsGrid="IsDisplayedAsGrid" IsDisplayedAsGridChanged="HandleDisplayFormatChange"/>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false" Class="btn btn--md" OnClick="OpenCreateClassModal" StartIcon="@Icons.Material.Filled.Add" Disabled="IsCreateClassModalOpen">Add Class</MudButton>
            </div>
        </div>

        @if (IsDisplayedAsGrid)
        {
            <div class="class-details-grid row">
                @foreach (var item in Classes.Result)
                {
                    <div class="col-xxl-3 col-lg-4 col-md-6 col-12">
                        <MudCard Class="class-details-card custom-card" Elevation="0">
                            @if (string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <MudImage Src="images/dummy-img.png" Height="208" Width="330" Class="img-fluid w-100 card__image"/>
                            }
                            else
                            {
                                <MudImage Src="@item.ImageUrl" Height="208" Width="330" Class="img-fluid w-100 card__image"/>
                            }
                            <MudCardContent Class="pa-0">
                                <MudPaper Elevation="0" Class="d-flex align-items-center justify-content-between mb-4 bg-transparent">
                                    <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="fw-bold">@item.Title</MudText>
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                             AnchorOrigin="Origin.BottomCenter"
                                             AriaLabel="Class Details Menu" Class="triple-dot-menu">
                                        <MudMenuItem @onclick="() => OpenUpdateClassModal(item.Id)">Edit</MudMenuItem>
                                        <MudMenuItem @onclick="() => NavigateToClassDetails(item.Id)">Details</MudMenuItem>
                                    </MudMenu>
                                </MudPaper>
                                <MudPaper Elevation="0" Class="d-flex flex-column gap-y-3 bg-transparent">
                                    <div>
                                        <div class="date d-flex align-items-center gap-x-2 mb-2">
                                            <MudImage Src="images/icons/calendar.svg" Alt="Blue Calendar Icon" Width="20" Height="20"/>
                                            <MudText Typo="Typo.subtitle2" Class="text-normal">@item.Date</MudText>
                                        </div>
                                        <div class="time d-flex align-items-center gap-x-2">
                                            <MudImage Src="images/icons/clock.svg" Alt="Blue Clock Icon" Width="20" Height="20"/>
                                            <MudText Typo="Typo.subtitle2" Class="text-normal">@item.StartTime - @item.EndTime</MudText>
                                        </div>
                                    </div>
                                    <div class="text-end mt-2">
                                        @switch (item.Status)
                                        {
                                            case Constants.Schedule.ScheduledAction:
                                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="btn custom-btn" DropShadow="false">
                                                    @item.Status
                                                </MudButton>
                                                break;
                                            case Constants.Schedule.CompletedAction:
                                                <MudButton Variant="Variant.Outlined" Color="Color.Success" Class="btn custom-btn" DropShadow="false">
                                                    @item.Status
                                                </MudButton>
                                                break;
                                            case Constants.Schedule.InProgressAction:
                                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Class="btn custom-btn" DropShadow="false">
                                                    @item.Status
                                                </MudButton>
                                                break;
                                        }
                                    </div>
                                </MudPaper>
                            </MudCardContent>
                        </MudCard>
                    </div>
                }
            </div>
        }
        else
        {
            <div>
                <div class="table-responsive">
                    <table class="table roles-table">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var classes in Classes.Result)
                        {
                            <tr>
                                <td>@(Classes.Result.IndexOf(classes) + 1).</td>
                                <td>@classes.Title</td>
                                <td>@classes.Date</td>
                                <td>@classes.StartTime - @classes.EndTime</td>
                                <td>
                                    @switch (classes.Status)
                                    {
                                        case Constants.Schedule.ScheduledAction:
                                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="btn custom-btn" DropShadow="false">
                                                @classes.Status
                                            </MudButton>
                                            break;
                                        case Constants.Schedule.CompletedAction:
                                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Class="btn custom-btn" DropShadow="false">
                                                @classes.Status
                                            </MudButton>
                                            break;
                                        case Constants.Schedule.InProgressAction:
                                            <MudButton Variant="Variant.Outlined" Color="Color.Info" Class="btn custom-btn" DropShadow="false">
                                                @classes.Status
                                            </MudButton>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="action">
                                        <MudTooltip Text="View Details" Color="Color.Primary" Arrow="true">
                                            <MudImage Src="images/icons/eye.svg" Alt="Upload Icon" Height="18" Width="18" @onclick="() => NavigateToClassDetails(classes.Id)"/>
                                        </MudTooltip>
                                        <MudTooltip Text="Edit" Color="Color.Primary" Arrow="true">
                                            <MudImage Src="images/icons/edit.svg" Alt="Edit Icon" Height="18" Width="18" @onclick="() => OpenUpdateClassModal(classes.Id)"/>
                                        </MudTooltip>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <Pagination PageCount="Classes.TotalPages"
                    SelectedPageSize="@PageSize"
                    SelectedPageSizeChanged="UpdatePageSize"
                    SelectedPageNumber="@PageNumber"
                    SelectedPageNumberChanged="UpdatePageNumber"
                    TotalRecords="Classes.TotalCount" />
    </div>

    if (IsCreateClassModalOpen)
    {
        <ModalLayout T="@CreateClassDto"
                     Module="Training"
                     Title="Add Class Details"
                     Description="Please fill in the following form to add a new class to the respective training."
                     SubmitColor="Color.Primary"
                     Size="modal-lg"
                     OnSave="@InsertClass"
                     CancelLabel="Discard"
                     SubmitLabel="Submit"
                     IsDisabled="IsCreateClassButtonDisabled">
            <div class="d-flex flex-column gap-4">
                <div class="row gap-y-5 mb-2">
                    <div class="col-xl-12 col-md-12 col-12">
                        <MudTextField @bind-Value="CreateClass.Title" Label="Title" For="@(() => CreateClass.Title)" Variant="Variant.Outlined" Placeholder="Enter the class title"/>
                    </div>
                    <div class="col-xl-6 col-md-6 col-6">
                        <MudDatePicker @bind-Date="CreateClass.Date"
                                       Label="Class Date"
                                       Placeholder="Select the class date"
                                       Variant="Variant.Outlined"
                                       PickerVariant="PickerVariant.Dialog"
                                       DateFormat="dd.MM.yyyy"
                                       IsDateDisabledFunc="@((DateTime dt) => dt < StartDate || dt > EndDate)"/>
                    </div>
                    <div class="col-xl-6 col-md-6 col-6">
                        <ResourceUpload AcceptedExtensions="@Constants.Uploads.ImageExtensions"
                                        FileUploadedMessage="Upload your image"
                                        UploadType="@Constants.Uploads.Image"
                                        OnFileUploaded="HandleCreateTrainingClassImageUpload"/>
                    </div>
                    <div class="col-xl-6 col-md-6 col-6">
                        <MudTimePicker PickerVariant="PickerVariant.Dialog" Label="Start Time" AmPm="true" @bind-Time="CreateClass.StartTime" Variant="Variant.Outlined" Placeholder="Select the start time"/>
                    </div>
                    <div class="col-xl-6 col-md-6 col-6">
                        <MudTimePicker PickerVariant="PickerVariant.Dialog" Label="End Time" AmPm="true" @bind-Time="CreateClass.EndTime" Variant="Variant.Outlined" Placeholder="Select the end time"/>
                    </div>
                </div>
            </div>
        </ModalLayout>
    }

    if (IsUpdateClassModalOpen)
    {
        <ModalLayout T="@UpdateClassDto"
                     Module="Training"
                     Title="Update Class Details"
                     Description="Please fill in the following form to update an existing class of the respective training."
                     SubmitColor="Color.Primary"
                     Size="modal-lg"
                     OnSave="@EditClass"
                     IsDisabled="IsUpdateClassButtonDisabled"
                     CancelLabel="Discard"
                     SubmitLabel="Submit">
            <div class="d-flex flex-column gap-4">
                <div class="row gap-y-5 mb-2">
                    <div class="col-xl-12 col-md-12 col-12">
                        <MudTextField @bind-Value="UpdateClass.Title" Label="Title" For="@(() => UpdateClass.Title)" Variant="Variant.Outlined" Placeholder="Enter the class title"/>
                    </div>
                    <div class="col-xl-6 col-md-6 col-6">
                        <MudDatePicker @bind-Date="UpdateClass.Date"
                                       Label="Class Date"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd.MM.yyyy"
                                       PickerVariant="PickerVariant.Dialog"
                                       IsDateDisabledFunc="@((DateTime dt) => dt < StartDate || dt > EndDate)"/>
                    </div>
                    <div class="col-xl-6 col-md-6 col-6">
                        <ResourceUpload AcceptedExtensions="@Constants.Uploads.ImageExtensions"
                                        FileUploadedMessage="Upload your image"
                                        UploadType="@Constants.Uploads.Image"
                                        OnFileUploaded="HandleUpdateTrainingClassImageUpload"/>
                    </div>
                    <div class="col-xl-6 col-md-6 col-6">
                        <MudTimePicker PickerVariant="PickerVariant.Dialog" Label="Start Time" AmPm="true" @bind-Time="UpdateClass.StartTime" Variant="Variant.Outlined"/>
                    </div>
                    <div class="col-xl-6 col-md-6 col-6">
                        <MudTimePicker PickerVariant="PickerVariant.Dialog" Label="End Time" AmPm="true" @bind-Time="UpdateClass.EndTime" Variant="Variant.Outlined"/>
                    </div>
                </div>
            </div>
        </ModalLayout>
    }
}