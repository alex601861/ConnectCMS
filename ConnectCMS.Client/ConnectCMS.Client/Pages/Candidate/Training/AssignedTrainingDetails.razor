@page "/candidate/assigned-trainings/training-details/{TrainingId:guid}/{ActivePanelIndex:int?}"
@attribute [Authorize]

<PageTitle>@Layout.PageTitle</PageTitle>

<Back NavigationUrl="@("/candidate/assigned-trainings")"/>

<MudTabs Elevation="0" PanelClass="bg-white" @bind-ActivePanelIndex="ActivePanelIndex" Class="gap-3">
    <MudTabPanel Text="Training Details">
        @if (ActivePanelIndex == 0)
        {
            <CMSTrain.Client.Pages.Candidate.Training.Details.TrainingDetails TrainingId="TrainingId"/>
        }
    </MudTabPanel>
    <MudTabPanel Text="Class Details" BadgeColor="Color.Secondary" BadgeData="@TrainingDetailsCountDto.ClassDetailsCount">
        @if (ActivePanelIndex == 1)
        {
            <CMSTrain.Client.Pages.Candidate.Training.Details.ClassDetails TrainingId="TrainingId"/>
        }
    </MudTabPanel>
    <MudTabPanel Text="Resource Materials" BadgeColor="Color.Secondary" BadgeData="@TrainingDetailsCountDto.ResourceDetailsCount">
        @if (ActivePanelIndex == 2)
        {
            <CMSTrain.Client.Pages.State.Resource.ResourceDetails ModuleId="TrainingId" 
                                                                  IsMaterialForTraining="true" 
                                                                  IsEditable="false" 
                                                                  IsAccessedByAdmin="false"
                                                                  IsDeletable="false" />
        }
    </MudTabPanel>
    <MudTabPanel Text="Candidate Details" BadgeColor="Color.Secondary" BadgeData="@TrainingDetailsCountDto.CandidateDetailsCount">
        @if (ActivePanelIndex == 3)
        {
            <CMSTrain.Client.Pages.Candidate.Training.Details.CandidateDetails TrainingId="TrainingId" 
                                                                               TrainingCandidateAssignment="TrainingCandidateAssignment"/>
        }
    </MudTabPanel>
    <MudTabPanel Text="Trainer Details" BadgeColor="Color.Secondary" BadgeData="@TrainingDetailsCountDto.TrainerDetailsCount">
        @if (ActivePanelIndex == 4)
        {
            <CMSTrain.Client.Pages.State.Trainer.TrainerDetails ModuleId="TrainingId" IsTrainerForTraining="true" IsAssignable="false"/>
        }
    </MudTabPanel>
    <MudTabPanel Text="Questionnaires" BadgeColor="Color.Secondary" BadgeData="@TrainingDetailsCountDto.InspectionCount">
        @if (ActivePanelIndex == 5)
        {
            <CMSTrain.Client.Pages.Candidate.Training.Details.QuestionnaireDetails TrainingId="TrainingId" 
                                                                                   TrainingCandidateAssignment="TrainingCandidateAssignment" />
        }
    </MudTabPanel>
    <MudTabPanel Text="Subordinates" BadgeColor="Color.Secondary" BadgeData="@TrainingDetailsCountDto.SubordinateCount"> 
        @if (ActivePanelIndex == 6)
        {
            <CMSTrain.Client.Pages.Candidate.Training.Details.SubordinateDetails TrainingId="TrainingId" 
                                                                                 TrainingCandidateAssignment="TrainingCandidateAssignment"/>
        }
    </MudTabPanel>
    <MudTabPanel Text="Certificates" BadgeColor="Color.Secondary" BadgeData="@TrainingDetailsCountDto.CertificationCount">
        @if (ActivePanelIndex == 7)
        {
            <CMSTrain.Client.Pages.Candidate.Training.Details.CertificationDetails TrainingId="TrainingId" />
        }
    </MudTabPanel>
</MudTabs>