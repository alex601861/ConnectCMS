                        What do you do well? What unique resources can you draw on?
                    </MudText>
                    <ul class="swot-analysis__list">
                        @foreach (var item in StrategyTraitsResult.Threats)
                        {
                            <li>@item.Name</li>
                        }
                    </ul>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
</div>