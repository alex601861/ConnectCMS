                        What do you do well? What unique resources can you draw on?
                    </MudText>
                    <ul class="swot-analysis__list">
                        @foreach (var item in StrategyTraitsResult.Opportunities)
                        {
                            <li>@item.Name</li>
                        }
                    </ul>
                </MudCardContent>
            </MudCard>
        </div>
        <div class="swot-analysis__grid-item col-xxl-3 col-sm-6 col-12 mb-4">
            <MudCard Elevation="0" class="swot-analysis__card">
                <MudImage Src="images/analysis/threat.png" Height="80" Width="80" />
